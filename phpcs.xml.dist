<?xml version="1.0"?>
<ruleset name="AI ParseAble">
	<description>WordPress-Extra + WordPress-Docs, PHP 7.4 compatibility.</description>
	<file>ai-parseable.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>mu</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files: Foo.php under src/, not class-foo.php. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.4"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="ai-parseable"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ai_parseable"/>
				<element value="AI_PARSEABLE"/>
				<element value="AiParseAble"/>
				<element value="aiparseable"/>
			</property>
		</properties>
	</rule>
	<rule ref="Universal.Arrays.DisallowShortArraySyntax"/>
</ruleset>
